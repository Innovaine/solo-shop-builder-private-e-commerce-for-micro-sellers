// Solo Shop Builder - Database Schema
// Stack: Postgres + Prisma ORM

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Seller account - one per email
model Seller {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  shops     Shop[]
  tokens    AuthToken[]
}

// Shop - single-tenant storefront
model Shop {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  sellerId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  seller    Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  products  Product[]
  orders    Order[]
  
  @@index([sellerId])
}

// Product - shop inventory items
model Product {
  id          String   @id @default(uuid())
  shopId      String
  title       String
  description String?  @db.Text
  price       Int      // Price in cents (e.g., 4500 = $45.00)
  imageUrl    String?
  category    String?  // Handmade, Vintage, Supplies, Other
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  
  @@index([shopId])
  @@index([category])
}

// Magic link tokens for passwordless auth
model AuthToken {
  id        String   @id @default(uuid())
  token     String   @unique
  sellerId  String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  
  seller    Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  
  @@index([token])
  @@index([sellerId])
  @@index([expiresAt]) // Optimize cleanup queries for expired tokens
  @@index([used, expiresAt]) // Composite index for auth verification queries
}

// Order - customer purchase record (FR-10, FR-15, FR-16, FR-17)
model Order {
  id                String   @id @default(uuid())
  shopId            String
  customerEmail     String
  customerName      String?
  status            String   @default("pending") // pending, paid, in_progress, shipped, delivered, canceled
  total             Int      // Total in cents
  stripePaymentId   String?  @unique // Stripe payment_intent ID
  trackingUrl       String?
  trackingId        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  shop              Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items             OrderItem[]
  
  @@index([shopId])
  @@index([customerEmail])
  @@index([status])
  @@index([stripePaymentId])
  @@index([createdAt]) // For sorting by date
}

// OrderItem - individual product line item in an order
model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  productId   String   // Reference to product at time of purchase
  productTitle String  // Snapshot title (in case product is deleted later)
  price       Int      // Snapshot price in cents
  quantity    Int      @default(1)
  
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  @@index([orderId])
  @@index([productId])
}

// Webhook - Stripe event audit trail (NFR-9)
model Webhook {
  id            String   @id @default(uuid())
  stripeEventId String   @unique
  eventType     String   // payment_intent.succeeded, charge.failed, etc.
  payload       String   @db.Text // Raw JSON payload
  status        String   @default("pending") // pending, processed, failed
  receivedAt    DateTime @default(now())
  processedAt   DateTime?
  createdAt     DateTime @default(now())
  
  @@index([stripeEventId])
  @@index([eventType])
  @@index([status])
  @@index([receivedAt])
}
