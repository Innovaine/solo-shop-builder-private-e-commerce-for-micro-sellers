FROM node:20-slim

WORKDIR /app

# Install system dependencies (OpenSSL for Prisma, Playwright deps for tests)
RUN apt-get update && apt-get install -y \
    openssl \
    ca-certificates \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libxkbcommon0 \
    libatspi2.0-0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    && rm -rf /var/lib/apt/lists/*

# CRITICAL FIX: Copy pre-installed node_modules from host to avoid OverlayFS corruption
# The host must run `npm install` BEFORE docker build
COPY node_modules ./node_modules

# Copy package.json and source code
COPY package.json ./
COPY . .

# Ensure public directory exists
RUN mkdir -p public

# Generate Prisma client (uses pre-installed node_modules, so no fs writes to graceful-fs)
RUN npx prisma generate

# Build Next.js (output: 'standalone' mode in next.config.js)
RUN npm run build

# Create test-results directory
RUN mkdir -p test-results

# Expose port
EXPOSE 3000

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Run migrations and start
CMD ["sh", "-c", "npx prisma migrate deploy && node server.js"]
